# Public values only. Found in Supabase → Project Settings → API.
# Vite inlines these at build time, so on Railway set them as service variables
# before building. Never put the service_role key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Post-harvest inspections (Harvests page, inspection mode on the phone) stay
# hidden unless this is "on". Records already made are kept either way.
# VITE_POST_HARVEST_INSPECTIONS=on
