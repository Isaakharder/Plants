{
  // Node-only tooling inside src (backtest runners that read database exports).
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tools.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.backtest.test.ts", "scripts/**/*.ts"],
  "exclude": []
}
